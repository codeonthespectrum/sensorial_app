# Configurações da API
SECRET_KEY=mude-esta-chave-para-algo-super-secreto-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MongoDB
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=ambientes_acessiveis

# Google Cloud (opcional para produção)
GOOGLE_CLOUD_PROJECT=seu-projeto-gcp
GOOGLE_MAPS_API_KEY=sua-chave-google-maps

# Ambiente
ENVIRONMENT=development
# ENVIRONMENT=production

# CORS (adicione o domínio do frontend em produção)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logs
LOG_LEVEL=INFO